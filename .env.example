NEXT_PUBLIC_APP_NAME=Workspace
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_CREDENTIALS=true

# Docker local ports (bound to loopback only)
APP_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Backend infrastructure; never expose these as NEXT_PUBLIC variables.
POSTGRES_DB=motel
POSTGRES_USER=motel
POSTGRES_PASSWORD=
REDIS_PASSWORD=
