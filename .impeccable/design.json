  "narrative": {
    "northStar": "The Clear Warehouse Board",
    "overview": "A clean, modern enterprise workspace for APA Nano warehouse operations: shift pulse, movements, and exceptions first; members and preferences as supporting tools. Mode: Operate.\n\nNeutral bordered surfaces support routine desktop work. Auth uses a full-bleed warehouse scene with a centered glass card and blue actions. The signed-in shell uses a fixed sidebar, header, and centered main column. Dashboard is a split board: live pulse strip, today’s movements, and attention/quick actions.\n\nProduct copy lives in `messages/` (en, fr, de, vi). This file is visual only. Demo metrics and demo sessions stay labelled.",
    "keyCharacteristics": [
      "Restrained operations-blue actions and neutral surfaces.",
      "Compact hierarchy with readable table content.",
      "Desktop-first structure with mobile access to the same tasks."
    ],
    "rules": [
      {
        "name": "The Purposeful Accent Rule",
        "body": "Use operations blue for primary actions, current navigation, and active status; keep secondary information neutral.",
        "section": "colors"
      },
      {
        "name": "The Auth Field Rule",
        "body": "Preserve the warehouse scene and centered auth form; routine Settings work stays on neutral card surfaces.",
        "section": "colors"
      },
      {
        "name": "The Local Overflow Rule",
        "body": "Keep wide records inside their own keyboard-focusable scrolling region (`overflow-x-auto`, `tabIndex={0}`) so the page remains usable on small screens.",
        "section": "layout"
      },
      {
        "name": "The Border First Rule",
        "body": "Use borders and surface tones to separate routine content; reserve stronger depth for dialogs and menus.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse semantic color tokens so light and dark themes stay aligned.",
      "Do keep visible labels, inline errors, named icon actions, and pending states.",
      "Do label demo metrics and demo sessions; never present sample counts as live reporting.",
      "Do respect reduced-motion preferences."
    ],
    "donts": [
      "Don't add decorative color or promotional display typography to routine administration.",
      "Don't use status color without a readable text label.",
      "Don't force wide tables to overflow the page.",
      "Don't put product strings in components; use translation keys."
    ]
  }
}
