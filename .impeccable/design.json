  "narrative": {
    "northStar": "The Clear Workspace",
    "overview": "A clean, modern enterprise workspace for finding members, editing access, and adjusting preferences. The explicitly selected minimal direction favors readable records, restrained color, and familiar navigation. Mode: Operate.\n\nNeutral bordered surfaces support routine desktop work. Auth uses a split brand panel; the signed-in shell uses a fixed sidebar, header, and centered main column. A mobile navigation drawer and locally scrolling tables preserve access to the same tasks. System sans-serif avoids external font requests in this offline starter.\n\nProduct copy lives in `messages/` (en, fr, de, vi). This file is visual only. Demo metrics and demo sessions stay labelled.",
    "keyCharacteristics": [
      "Restrained forest-green actions and neutral surfaces.",
      "Compact hierarchy with readable table content.",
      "Desktop-first structure with mobile access to the same tasks."
    ],
    "rules": [
      {
        "name": "The Purposeful Accent Rule",
        "body": "Use forest green for primary actions, current navigation, and active status; keep secondary information neutral.",
        "section": "colors"
      },
      {
        "name": "The Local Overflow Rule",
        "body": "Keep wide records inside their own keyboard-focusable scrolling region so the page remains usable on small screens.",
        "section": "layout"
      },
      {
        "name": "The Auth Field Rule",
        "body": "Forest green may fill the left auth panel at large breakpoints. Everywhere else it stays on actions, current nav, icons, and status — not on page backgrounds.",
        "section": "colors"
      },
      {
        "name": "The Border First Rule",
        "body": "Use borders and surface tones to separate routine content; reserve stronger depth for dialogs.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse semantic color tokens so light and dark themes stay aligned.",
      "Do keep visible labels, inline errors, named icon actions, and pending states.",
      "Do label demo metrics and demo sessions; never present sample counts as live reporting.",
      "Do respect reduced-motion preferences."
    ],
    "donts": [
      "Don't add decorative color or promotional display typography to routine administration.",
      "Don't use status color without a readable text label.",
      "Don't force wide tables to overflow the page.",
      "Don't put product strings in components; use translation keys."
    ]
  }
}
