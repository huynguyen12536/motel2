NEXT_PUBLIC_APP_NAME=WMS APA Nano
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_CREDENTIALS=true

# Frontend (Next.js) listen port — `pnpm dev` / `pnpm start` đọc biến này
PORT=3000

# Docker host bind port (compose maps this → container :3000)
APP_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Backend infrastructure; never expose these as NEXT_PUBLIC variables.
POSTGRES_DB=motel
POSTGRES_USER=motel
POSTGRES_PASSWORD=
REDIS_PASSWORD=
