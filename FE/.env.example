# Public values. Next.js inlines every NEXT_PUBLIC_* variable into the client bundle at build time.
# Do not put passwords, tokens, or private keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_NAME=WMS APA Nano
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_CREDENTIALS=true

# Local `pnpm dev` / `pnpm start` port. Not part of the client bundle.
PORT=3000
# Canonical browser origin for same-origin login/refresh/logout checks (server-only).
AUTH_PUBLIC_ORIGIN=http://localhost:3000

# Local infrastructure placeholders copied by `pnpm env:init`.
# The Next.js app does not read these. Never prefix them with NEXT_PUBLIC_.
APP_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_DB=motel
POSTGRES_USER=motel
POSTGRES_PASSWORD=
REDIS_PASSWORD=
