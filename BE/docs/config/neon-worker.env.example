# Review-only template. Not loaded by Compose; BE/.env.worker remains absent.
NODE_ENV=production
MASTER_DATABASE_URL=
NEON_API_KEY=
NEON_PROVISIONING_DIRECT_URL=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
NEON_AUTHORIZED_PROJECT_ID=
NEON_AUTHORIZED_BRANCH_ID=
TENANT_ALLOWED_DATABASE_HOSTS=
TENANT_CREDENTIAL_KEYS=
TENANT_CREDENTIAL_VERSION=v1
NEON_MAX_TENANT_DATABASES=2
TENANT_PROVISIONING_CONCURRENCY=1
TENANT_PROVISIONING_MAX_ATTEMPTS=3
POSTGRES_POOL_MAX=5
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
TENANT_PROVISIONING_ENABLED=false
MASTER_PROVISIONING_AUTHORIZED=false
TENANT_ADMIN_BOOTSTRAP_ENABLED=false
TENANT_MIGRATION_ROLLOUT_ENABLED=false
# Do not inject JWT or platform-admin secrets into the worker.
# MASTER_DIRECT_URL belongs in a separate, approved migration process, never a tenant fallback.
