# Review-only template. Not loaded by Compose. Obtain each secret through the operator's secret manager.
NODE_ENV=production
APP_PORT=8080
MASTER_DATABASE_URL=
PLATFORM_ADMIN_SECRET=
JWT_ACCESS_SECRET=
TENANT_CREDENTIAL_KEYS=
TENANT_CREDENTIAL_VERSION=v1
TENANT_ALLOWED_DATABASE_HOSTS=
TENANT_CLIENT_MAX=5
TENANT_POOL_MAX=2
POSTGRES_POOL_MAX=5
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Enable only under target-specific approval. API intent needs the same verified policy as the worker.
TENANT_PROVISIONING_ENABLED=false
MASTER_PROVISIONING_AUTHORIZED=false
NEON_PROJECT_ID=
NEON_BRANCH_ID=
NEON_AUTHORIZED_PROJECT_ID=
NEON_AUTHORIZED_BRANCH_ID=
NEON_MAX_TENANT_DATABASES=2
TENANT_ADMIN_BOOTSTRAP_ENABLED=false
TENANT_MIGRATION_ROLLOUT_ENABLED=false
# Never inject NEON_API_KEY, NEON_PROVISIONING_DIRECT_URL or Master migration credentials here.
