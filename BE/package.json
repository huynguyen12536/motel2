{
  "name": "wms-apa-nano-be",
  "version": "0.1.0",
  "private": true,
  "description": "WMS APA Nano backend API",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.9.0 <25"
  },
  "scripts": {
    "dev": "pnpm build && node scripts/dev.mjs",
    "start": "node dist/src/index.js",
    "build": "pnpm db:generate && tsc -p tsconfig.json",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "db:generate": "pnpm prisma:master:generate && pnpm prisma:tenant:generate",
    "db:validate": "prisma validate --config prisma.config.ts && prisma validate --config prisma.tenant.config.ts",
    "db:migrate": "tsx scripts/migrate.ts master",
    "db:deploy": "tsx scripts/deploy-migrations.ts",
    "db:ping": "tsx scripts/ping-database.ts",
    "test:logger": "node --import tsx --test tests/logger-rotation.test.ts",
    "dev:compile": "tsc -p tsconfig.json --watch",
    "start:prod": "node dist/src/index.js",
    "lint": "eslint src logger scripts",
    "format": "prettier --write src logger scripts tests *.json *.mjs *.ts *.yml docs",
    "test": "pnpm build && node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "pnpm test --testPathPatterns=unit",
    "test:smoke": "pnpm test --testPathPatterns=smoke",
    "test:integration": "pnpm test --testPathPatterns=integration",
    "prisma:master:generate": "prisma generate --config prisma.config.ts",
    "prisma:tenant:generate": "prisma generate --config prisma.tenant.config.ts",
    "prisma:master:migrate:deploy": "tsx scripts/migrate.ts master",
    "prisma:tenant:migrate:deploy": "tsx scripts/migrate.ts tenant",
    "docker:up": "docker compose --env-file .env -f ../compose.yaml -f ../compose.dev.yaml --profile workers up -d --wait",
    "docker:down": "docker compose --env-file .env -f ../compose.yaml -f ../compose.dev.yaml --profile workers down",
    "docker:logs": "docker compose --env-file .env -f ../compose.yaml -f ../compose.dev.yaml --profile workers logs -f",
    "prisma:master:migrate:status": "tsx scripts/migrate.ts master status",
    "test:master:integration": "pnpm build && node scripts/test-master-integration.mjs",
    "docker:prod:config": "docker compose --env-file .env -f ../compose.yaml config --quiet",
    "docker:rebuild": "docker compose --env-file .env -f ../compose.yaml -f ../compose.dev.yaml --profile workers up -d --build --wait",
    "docker:stop": "docker compose --env-file .env -f ../compose.yaml -f ../compose.dev.yaml --profile workers stop",
    "docker:start": "docker compose --env-file .env -f ../compose.yaml -f ../compose.dev.yaml --profile workers start --wait",
    "test:saas:integration": "pnpm build && node scripts/test-saas-integration.mjs",
    "worker:start": "node dist/src/workers/provisioning.main.js",
    "tenant:migrations:run": "node dist/src/operations/migrate-tenants.main.js",
    "docker:worker:config": "docker compose --env-file .env -f ../compose.yaml -f ../compose.dev.yaml --profile workers config --quiet",
    "neon:readiness": "node scripts/neon-readiness.mjs",
    "auth:seed": "node dist/src/operations/authorization-init.main.js",
    "test:authorization:integration": "pnpm build && node scripts/test-authorization-integration.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "amqplib": "2.2.0",
    "casbin": "5.51.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "redis": "6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.15.5",
    "eslint": "^10.13.0",
    "jest": "30.5.2",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.9.10",
    "prisma": "7.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
