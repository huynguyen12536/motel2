NODE_ENV=development
PORT=8080
APP_NAME=wms-apa-nano-be
LOG_LEVEL=debug

# Prefer DATABASE_URL. If empty, it is built from POSTGRES_* below.
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=motel
POSTGRES_USER=motel
POSTGRES_PASSWORD=
POSTGRES_SSL=false
POSTGRES_POOL_MAX=10

REDIS_URL=
REDIS_PASSWORD=

# Comma-separated browser origins (FE). Required when credentials are used.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
BODY_LIMIT=1mb

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
