# Host development. In Docker Compose service names override these hostnames.
NODE_ENV=development
APP_PORT=8080
APP_NAME=wms-apa-nano-be
API_PREFIX=api/v1
# Runtime: pooled Neon URL, sslmode=require. Legacy DATABASE_URL is a fallback.
MASTER_DATABASE_URL=
MASTER_DIRECT_URL=
DATABASE_URL=
DIRECT_URL=
# Explicit opt-in: no Neon connection made by the new readiness probe otherwise.
DATABASE_VERIFY=false
TENANT_DATABASE_URL=
TENANT_DIRECT_URL=
# Worker provisioning identity; disabled by default. Never expose to frontend.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
# Fill these three credentials with independent locally generated values.
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=
REDIS_PASSWORD=
POSTGRES_POOL_MAX=10
POSTGRES_SSL=false
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_SIZE_MB=10
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:3000
BODY_LIMIT=1mb
# Tenant auth access key: optional for infrastructure startup; supply random key for login.
# JWT_REFRESH_SECRET is a legacy key; refresh sessions use random opaque credentials.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Temporary platform-admin API key. Supply 32+ random bytes (base64url or hex); no default.
PLATFORM_ADMIN_SECRET=

# SaaS runtime: real resource creation requires separate operator authorization.
TENANT_PROVISIONING_ENABLED=false
MASTER_PROVISIONING_AUTHORIZED=false
NEON_AUTHORIZED_PROJECT_ID=
NEON_AUTHORIZED_BRANCH_ID=
NEON_MAX_TENANT_DATABASES=10
# Worker-only privileged direct credential; keep out of the API environment.
NEON_PROVISIONING_DIRECT_URL=
# 32 random bytes in base64url. API/worker need the matching secure key version.
TENANT_CREDENTIAL_KEY=
# Optional version -> key JSON keyring for controlled rotation; never commit real keys.
TENANT_CREDENTIAL_KEYS=
TENANT_CREDENTIAL_VERSION=v1
TENANT_ALLOWED_DATABASE_HOSTS=
TENANT_DB_NAME_PREFIX=tenant_
TENANT_PROVISIONING_CONCURRENCY=2
TENANT_PROVISIONING_MAX_ATTEMPTS=3
TENANT_PROVISIONING_POLL_MS=2000
TENANT_PROVISIONING_LEASE_MS=60000
TENANT_PROVISIONING_RETRY_MS=10000
RABBITMQ_PROVISIONING_EXCHANGE=tenant.provisioning.exchange
RABBITMQ_PROVISIONING_QUEUE=tenant.provisioning.requested
RABBITMQ_PROVISIONING_RETRY_QUEUE=tenant.provisioning.retry
RABBITMQ_PROVISIONING_DLQ=tenant.provisioning.dlq
TENANT_CLIENT_MAX=50
TENANT_POOL_MAX=3
TENANT_CLIENT_IDLE_MS=60000
TENANT_CACHE_TTL_SECONDS=30
TENANT_ADMIN_BOOTSTRAP_ENABLED=false
TENANT_MIGRATION_ROLLOUT_ENABLED=false
JWT_ISSUER=motel-api
JWT_AUDIENCE=motel-tenants

# Platform identities are separate from tenant JWTs. Supply random secrets through your secret manager.
PLATFORM_JWT_SECRET=
PLATFORM_BOOTSTRAP_ENABLED=false
PLATFORM_BOOTSTRAP_EMAIL=
PLATFORM_BOOTSTRAP_PASSWORD=
# Optional legacy key compatibility: an explicit ACTIVE platform user with current Casbin assignments.
PLATFORM_LEGACY_ADMIN_USER_ID=
# Dedicated, separately approved post-migration initialization job; never used as runtime URL fallback.
AUTHZ_INIT_DATABASE_URL=
AUTHZ_INIT_DOMAIN=
AUTHZ_INIT_AUTHORIZATION_REF=
AUTHZ_INIT_EXPECTED_HOST=
AUTHZ_INIT_EXPECTED_PORT=
AUTHZ_INIT_EXPECTED_DATABASE=
AUTHZ_INIT_EXPECTED_OWNER=
